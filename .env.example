# ============================================================
# cdci — configurazione locale
# Copia questo file in .env e sistemalo, NON committare .env
#   cp .env.example .env
# ============================================================

# --- API (ml-api) -------------------------------------------------
# Porta pubblica su cui risponde l'app (e su cui la pipeline deploya)
ML_API_PORT=8003

# --- Jenkins ------------------------------------------------------
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=cambia-la-password
JENKINS_PORT=8089
JENKINS_AGENT_PORT=50001

# --- Permesso build Docker (OBBLIGATORIO, varia da PC a PC) ------
# Scrivi qui il gruppo del socket docker della TUA macchina:
#   echo "DOCKER_GID=$(stat -c %g /var/run/docker.sock)" >> .env
DOCKER_GID=

# --- Monitoring ---------------------------------------------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100

# Porta provvisoria usata dalla pipeline per il dry-run health check
# (non usarla se e' gia' occupata sul tuo host)
CI_HEALTH_PORT=18003
